{
  "name": "ambulanzsystem-contract",
  "private": true,
  "description": "Frozen API contract + mock server for parallel frontend/backend development (Stage 0).",
  "scripts": {
    "mock": "prism mock openapi.yaml --port 4010",
    "lint": "spectral lint openapi.yaml",
    "generate": "openapi-typescript openapi.yaml -o ../frontend/src/app/api/openapi-types.ts",
    "check:generated": "openapi-typescript openapi.yaml -o ../frontend/src/app/api/openapi-types.ts --check"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "^5.16.0",
    "@stoplight/spectral-cli": "^6.16.3",
    "openapi-typescript": "^7.13.0"
  },
  "overrides": {
    "@redocly/openapi-core": {
      ".": "1.34.19",
      "brace-expansion": "2.1.4",
      "js-yaml": "4.3.1"
    },
    "@stoplight/spectral-core": {
      "brace-expansion": "1.1.18"
    },
    "ajv": {
      "fast-uri": "3.1.6"
    },
    "postman-collection": {
      "lodash": "4.18.1",
      "uuid": "11.1.1"
    }
  }
}
