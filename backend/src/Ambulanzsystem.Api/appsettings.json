{
  "Logging": {
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Features": {
    "RedactPersonalData": true
  },
  "Mqtt": {
    "Enabled": false,
    "RedactName": true,
    "RedactLocation": false
  }
}
