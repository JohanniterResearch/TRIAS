# PLS client site (PLS parity plan WP 7.2). install.sh copies this file into sites/ only when
# PLS_SITE_ADDRESS is set in .env; the main Caddyfile imports sites/*.caddy.
{$PLS_SITE_ADDRESS} {
	tls {$TLS_ISSUER}
	encode zstd gzip

	# One backend for both UIs: the PLS client calls its own origin, so no CORS is involved.
	# The backend sets its own security headers (and HSTS in production) on these responses.
	@backend path /api/* /hubs/* /health
	handle @backend {
		reverse_proxy backend:8080
	}

	handle {
		# Same baseline as the API (SecurityHeadersMiddleware). The PLS map loads tiles from the
		# a/b/c.tile.openstreetmap.org hosts (images only); the service worker needs worker-src 'self'.
		header {
			Strict-Transport-Security "max-age=31536000"
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy no-referrer
			Permissions-Policy "camera=(self), geolocation=(self), microphone=()"
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org https://*.tile.openstreetmap.org; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		}
		# Hashed assets are cached for good; everything else is revalidated, including deep links
		# answered with index.html, so a device never keeps an old shell or service worker.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@fresh not path /assets/*
		header @fresh Cache-Control "no-cache"
		root * /srv/pls
		try_files {path} /index.html
		file_server
	}
}
