        {
          "fields": [
            { "id": "adresse", "label": "Adresse", "type": "line_text", "bind": "patient.adresse" },
            { "id": "staat", "label": "Staat", "type": "line_text", "bind": "patient.staat" },
            { "id": "telefon", "label": "Telefon", "type": "tel", "bind": "patient.telefon" }
          ]
        },
        {
          "fields": [
            { "id": "arbeitgeber", "label": "Arbeitgeber", "type": "line_text", "bind": "patient.arbeitgeber" },
            { "id": "versicherungstraeger", "label": "Versicherungsträger", "type": "line_text", "bind": "patient.versicherungstraeger" },
            {
              "id": "familienstand",
              "label": "Familienstand",
              "type": "segmented_text_visual",
              "bind": "patient.familienstand"
            }
          ]
        }
      ]
    },
