{
  "meta": {
    "sourceOfTruth": true,
    "scope": "page1-paper-mirror-layout",
    "mustReadBeforeImplementation": true
  },
  "document": {
    "id": "johanniter_ambdoku_page1_paper_mirror",
    "title": "Johanniter Ambulanzprotokoll - Seite 1",
    "language": "de-AT",
    "sourcePage": 1,
    "pageAspectRatio": "A4-portrait",
    "baseCanvas": { "width": 1241, "height": 1755 },
    "uxMode": "paper-mirror"
  },
  "renderRules": {
    "preserveZonePlacement": true,
    "preserveSectionOrder": true,
    "preserveOriginalLabels": true,
    "preserveCheckboxOrdering": true,
    "preservePaperVisualAnchors": true,
    "responsiveStrategy": "scale-page-not-reflow-page",
    "maxAllowedReflow": "inside-zone-only",
    "visualStyle": {
      "sectionBandColor": "#d9a3a3",
      "borderColor": "#111111",
      "backgroundColor": "#f6f6f6",
      "inputStyle": "paper-line",
      "checkboxStyle": "paper-square",
      "fontTone": "clinical-minimal"
    }
  },
  "contracts": {
    "assessment_secondary_bodymap": {
      "bind": "assessment_secondary.bodymap",
      "type": "array",
      "items": {
        "view": {
          "type": "string",
          "enum": ["front", "back"]
        },
        "marker": {
          "type": "string",
          "enum": ["wunde", "fraktur", "schmerz", "prellung", "amputation", "verbrennung", "luxation"]
        },
        "x": {
          "type": "number",
          "unit": "percent"
        },
        "y": {
          "type": "number",
          "unit": "percent"
        }
      }
    },
    "medications_administered": {
      "bind": "medications_administered",
      "type": "array",
      "maxItems": 8,
      "items": {
        "medikament": { "type": "string" },
        "dosis": { "type": "string" },
        "art": { "type": "string" },
        "uhrzeit": {
          "type": ["string", "null"],
          "format": "HH:mm"
        }
      }
    },
    "vitals_schmerz": {
      "bind": "vitals.schmerz",
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 10,
      "naBind": "vitals.schmerz_nicht_beurteilbar"
    },
    "signatures_entlass_san_na": {
      "bind": "signatures.entlass_san_na",
      "type": ["string", "null"],
      "format": "data-url-png"
    }
  },
  "zones": [
    {
      "id": "brand_header",
      "rectPct": { "x": 0, "y": 0, "w": 23, "h": 6 },
      "type": "static_branding",
      "content": ["JOHANNITER", "AMBULANZPROTOKOLL"]
    },
    {
      "id": "incident_header",
      "rectPct": { "x": 23, "y": 0, "w": 77, "h": 6 },
      "type": "group",
      "rows": [
        {
          "fields": [
            { "id": "ambulanzort", "label": "Ambulanzort", "type": "line_text", "bind": "incident.ambulanzort" },
            { "id": "pls_nummer", "label": "Protokoll- / PLS-Nummer", "type": "line_text", "bind": "incident.pls_nummer" }
          ]
        },
        {
          "fields": [
            {
              "id": "datum_segmented",
              "label": "Datum",
              "type": "segmented_date_visual",
              "bind": "incident.datum",
              "segments": ["T", "T", "M", "M", "J", "J"]
            },
            { "id": "uhrzeit_beginn", "label": "Uhrzeit-Beginn", "type": "time", "bind": "incident.uhrzeit_beginn" },
            { "id": "dnr_san_1", "label": "DNr. - San.", "type": "line_text", "bind": "incident.dnr_san_1" },
            { "id": "dnr_san_2", "label": "DNr. - San.", "type": "line_text", "bind": "incident.dnr_san_2" },
            { "id": "dnr_san_3", "label": "DNr. - San.", "type": "line_text", "bind": "incident.dnr_san_3" },
            { "id": "dnr_na", "label": "DNr. - NA", "type": "line_text", "bind": "incident.dnr_na" },
            { "id": "funkrufname", "label": "Funkrufname / Behandlungsplatz", "type": "line_text", "bind": "incident.funkrufname" }
          ]
        }
      ]
    },
    {
      "id": "patient_block",
      "rectPct": { "x": 0, "y": 6, "w": 100, "h": 10 },
      "type": "group",
      "rows": [
        {
          "fields": [
            { "id": "familienname", "label": "Patient - Familienname", "type": "line_text", "bind": "patient.familienname" },
            { "id": "vorname", "label": "Vorname", "type": "line_text", "bind": "patient.vorname" },
            {
              "id": "geschlecht",
              "label": "Ges.",
